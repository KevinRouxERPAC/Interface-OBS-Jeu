# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for specific files
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
