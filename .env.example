# Configuration du serveur API
# Copiez ce fichier en .env dans le dossier api/ et remplissez vos valeurs

# Environnement (development | production)
NODE_ENV=development

# Port du serveur API (optionnel, par défaut 3000)
PORT=3000

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Niveau de logging (error | warn | info | debug)
LOG_LEVEL=info

# ============================================
# Google Sheets (base de données)
# Importée dans data/*.json à chaque démarrage.
# ============================================

