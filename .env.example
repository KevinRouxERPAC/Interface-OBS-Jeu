# Configuration du serveur API
# Copiez ce fichier en .env dans le dossier api/ et remplissez vos valeurs

# Environnement (development | production)
NODE_ENV=development

# Port du serveur API (optionnel, par défaut 3000)
PORT=3000

# Clé API pour sécuriser les endpoints (requis en production)
API_KEY=your-secret-api-key-here

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Niveau de logging (error | warn | info | debug)
LOG_LEVEL=info

# ============================================
# Google Sheets Configuration (optionnel)
# ============================================

# ID du Google Sheet (trouvé dans l'URL entre /d/ et /edit)
GOOGLE_SHEETS_ID=your_sheet_id_here

# Email du compte de service Google
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Clé privée du compte de service (avec \n pour les retours à la ligne)
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Plages de données dans le Google Sheet (optionnel, valeurs par défaut)
GOOGLE_SHEETS_QUESTIONS_RANGE=Questions!A2:J
GOOGLE_SHEETS_THEMES_RANGE=Theme!A2:D
GOOGLE_SHEETS_CATEGORIES_RANGE=Category!A2:E
GOOGLE_SHEETS_LEVELS_RANGE=Level!A2:B
GOOGLE_SHEETS_MATIERES_RANGE=Matiere!A2:B
