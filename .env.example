# Configuration du serveur
PORT=3000

# Google Sheets - ID du spreadsheet (visible dans l'URL)
# Exemple: https://docs.google.com/spreadsheets/d/VOTRE_ID_ICI/edit
GOOGLE_SHEETS_ID=votre_id_de_spreadsheet_ici

# Chemin vers le fichier de credentials du compte de service Google
GOOGLE_SERVICE_ACCOUNT_PATH=./server/credentials/service-account.json

# Timeout pour les appels Google Sheets (en millisecondes)
GOOGLE_TIMEOUT=10000
