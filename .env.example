# Google Sheets Configuration (optionnel)
# Copiez ce fichier en .env et remplissez vos valeurs

# ID du Google Sheet (trouvé dans l'URL)
SHEET_ID=your_sheet_id_here

# Email du compte de service Google
SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Clé privée du compte de service (avec \n pour les retours à la ligne)
SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Port du serveur API (optionnel, par défaut 3000)
PORT=3000
